APP_ENV=development
OPENROUTER_API_KEY=
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MODEL=openai/gpt-5.4-mini
WEB_SEARCH_TIMEOUT_SECONDS=60
WEB_SEARCH_MAX_OUTPUT_TOKENS=2000
JEV_BASE_URL=https://openrouter.ai/api
JEV_MODEL=typesafe/jev-1.14
JEV_TIMEOUT_SECONDS=15
JEV_TOTAL_TIMEOUT_SECONDS=20
# Routing applies only when both V2_ENABLED and V2_ROUTING_ENABLED are true.
ROUTING_QUERY_MAX_STATE_CHARS=32768
ROUTING_QUERY_MAX_PAYLOAD_BYTES=131072
ROUTING_MODE=active
ROUTING_FALLBACK_ENABLED=true
ROUTING_PRIMARY_TIMEOUT_SECONDS=8
ROUTING_MAX_PROVIDER_CALLS=12
ROUTING_MAX_RESERVED_TOKENS=20000
ROUTING_MIN_PROBABILITY=0.6
ROUTING_MIN_MARGIN=0.1
ROUTING_BREAKER_THRESHOLD=3
ROUTING_BREAKER_COOLDOWN_SECONDS=30
ROUTING_ALLOW_EXTERNAL=true
ROUTING_SEND_OBSERVATIONS=true
ROUTING_REDACT_PII=true
# Capability choice includes the same recent conversation as query routing.
ROUTING_MAX_STATE_CHARS=32768
ROUTING_MAX_PAYLOAD_BYTES=131072
# V2 master switch and individual features are opt-in; implementations arrive in later tasks.
V2_ENABLED=false
V2_PLUGINS_ENABLED=false
V2_ROUTING_ENABLED=false
V2_RAG_ENABLED=false
V2_PLANNING_ENABLED=false
V2_PARALLEL_ENABLED=false
V2_REDIS_CACHE_ENABLED=false
V2_EVENTS_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_agent_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=5
LANGGRAPH_CHECKPOINT_AUTO_SETUP=true
AUTH_SECRET_KEY=generate_a_random_secret_here
AUTH_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_CACHE_HIT_PRICE_PER_MILLION_USD=0.006
DEEPSEEK_CACHE_MISS_PRICE_PER_MILLION_USD=0.30
DEEPSEEK_OUTPUT_PRICE_PER_MILLION_USD=1.20
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=personal-ai-agent
LANGSMITH_SAMPLING_RATE=1.0
OPERATIONAL_ERROR_RETENTION_DAYS=30
TOOL_PAYLOAD_RETENTION_DAYS=30
AGENT_RUN_RETENTION_DAYS=90
BACKGROUND_JOB_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=180
ADMIN_ALERT_FAILURE_RATE=0.10
ADMIN_ALERT_CACHE_HIT_RATE=0.20
ADMIN_ALERT_MODEL_P95_MS=10000
ADMIN_ALERT_STUCK_RUN_MINUTES=10
ADMIN_ALERT_MIN_SAMPLE_COUNT=5
ADMIN_ALERT_MIN_CACHE_TOKENS=1000
CHAT_HISTORY_LIMIT=20
HISTORY_COMPRESSION_BATCH_SIZE=10
HISTORY_SUMMARY_MERGE_FACTOR=4
HISTORY_SUMMARY_MAX_CHARS=6000
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_MIN_CONFIDENCE=0.6
MEMORY_EXTRACTION_TIMEOUT_SECONDS=20
MEMORY_RETRIEVAL_MIN_CONFIDENCE=0.6
MEMORY_RETRIEVAL_MAX_ITEMS=20
MEMORY_RETRIEVAL_CANDIDATE_LIMIT=100
MEMORY_RETENTION_NORMAL_DAYS=365
MEMORY_RETENTION_PERSONAL_DAYS=180
MEMORY_RETENTION_SENSITIVE_DAYS=30
AGENT_MAX_STEPS=8
AGENT_MAX_TOTAL_TOKENS=20000
AGENT_MAX_DURATION_SECONDS=120
AGENT_MAX_IDENTICAL_TOOL_CALLS=3
AGENT_MAX_REPEATED_OBSERVATIONS=3
AGENT_REQUESTS_PER_MINUTE=10
AGENT_RUNS_PER_DAY=100
AGENT_TOKENS_PER_DAY=1000000
AGENT_TOOL_CALLS_PER_DAY=500
MCP_DEMO_ENABLED=true
# Reviewed host-owned stdio profiles; restart after changing this file.
MCP_STDIO_CONFIG_PATH=plugins/stdio/servers.json
MCP_HTTP_CONFIG_PATH=plugins/http/servers.json
PLUGIN_PACKAGES_CONFIG_PATH=plugins/packages.json
# Fernet key ring (newest first); leave empty until credential storage is configured.
MCP_CREDENTIAL_ENCRYPTION_KEYS=
PYTHON_SANDBOX_ENABLED=true
# Shared system mailbox. Enable after filling the Gmail address and App Password.
# Use port 465/ssl or 587/starttls. Empty FROM defaults to SMTP_USERNAME.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=20
BACKGROUND_QUEUE_NAME=default
BACKGROUND_WORKER_POLL_SECONDS=1
# Optional per-worker heartbeat; Docker config uses /tmp/agent-worker/heartbeat.json.
BACKGROUND_WORKER_HEARTBEAT_PATH=
BACKGROUND_WORKER_HEARTBEAT_MAX_AGE_SECONDS=15
BACKGROUND_JOB_LEASE_SECONDS=30
BACKGROUND_JOB_CONTROL_POLL_SECONDS=1
BACKGROUND_JOB_RETRY_BASE_SECONDS=1
BACKGROUND_JOB_RETRY_MAX_SECONDS=60
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=1
TOOL_RETRY_BACKOFF_SECONDS=0.2
TOOL_ALLOWLIST=demo__get_server_time,demo__calculate,demo__count_text,demo__convert_temperature,demo__simulate_sensitive_action,demo__get_admin_runtime_info,run_python_code,send_email,search_web
TOOL_APPROVAL_TIMEOUT_SECONDS=300
TOOL_LAZY_LOAD_THRESHOLD=4
TOOL_MAX_LOADED=4
SKILL_SELECTION_MIN_SCORE=20
SKILL_SELECTION_AMBIGUITY_MARGIN=5
CONTEXT_MAX_INPUT_TOKENS=36000
CONTEXT_SYSTEM_TOKEN_BUDGET=2000
CONTEXT_MEMORY_TOKEN_BUDGET=4000
CONTEXT_HISTORY_TOKEN_BUDGET=16000
CONTEXT_TOOL_TOKEN_BUDGET=6000
CONTEXT_RAG_TOKEN_BUDGET=8000
# Private library. Upload queues preparation; Q&A stays unavailable until embedding/retrieval is connected.
DOCUMENT_STORAGE_PATH=data/documents
DOCUMENT_MAX_FILE_BYTES=20971520
DOCUMENT_MAX_USER_BYTES=209715200
DOCUMENT_MAX_DOCUMENTS=1000
DOCUMENT_MAX_UNPACKED_BYTES=104857600
DOCUMENT_MAX_ARCHIVE_ENTRIES=2000
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_TEXT_CHARS=5000000
DOCUMENT_MAX_CHUNKS=20000
DOCUMENT_MAX_ARTIFACT_BYTES=134217728
DOCUMENT_PROCESS_TIMEOUT_SECONDS=1800
DOCUMENT_PROCESS_MEMORY_MB=4096
# Install extra ingestion in the worker environment. Windows example: C:/Program Files/LibreOffice/program/soffice.com
DOCUMENT_LIBREOFFICE_PATH=soffice
DOCUMENT_MODEL_CACHE_PATH=data/models
# Resolved to a Hugging Face commit and stored alongside prepared chunks.
DOCUMENT_EMBEDDING_REVISION=main
DOCUMENT_EMBEDDING_BATCH_SIZE=4
DOCUMENT_EMBEDDING_TIMEOUT_SECONDS=600
DOCUMENT_EMBEDDING_MEMORY_MB=4096
DOCUMENT_RERANKER_REVISION=main
DOCUMENT_RERANKER_BATCH_SIZE=1
DOCUMENT_RERANKER_TIMEOUT_SECONDS=600
DOCUMENT_RERANKER_MEMORY_MB=4096
DOCUMENT_REWRITE_TIMEOUT_SECONDS=30
DOCUMENT_QA_TIMEOUT_SECONDS=600
DOCUMENT_REWRITE_HISTORY_MESSAGES=8
DOCUMENT_REWRITE_HISTORY_TOKENS=2000
