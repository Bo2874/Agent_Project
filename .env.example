APP_ENV=development
# V2 master switch and individual features are opt-in; implementations arrive in later tasks.
V2_ENABLED=false
V2_PLUGINS_ENABLED=false
V2_ROUTING_ENABLED=false
V2_RAG_ENABLED=false
V2_PLANNING_ENABLED=false
V2_PARALLEL_ENABLED=false
V2_REDIS_CACHE_ENABLED=false
V2_EVENTS_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_agent_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=5
LANGGRAPH_CHECKPOINT_AUTO_SETUP=true
AUTH_SECRET_KEY=generate_a_random_secret_here
AUTH_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_CACHE_HIT_PRICE_PER_MILLION_USD=0.006
DEEPSEEK_CACHE_MISS_PRICE_PER_MILLION_USD=0.30
DEEPSEEK_OUTPUT_PRICE_PER_MILLION_USD=1.20
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=personal-ai-agent
LANGSMITH_SAMPLING_RATE=1.0
OPERATIONAL_ERROR_RETENTION_DAYS=30
TOOL_PAYLOAD_RETENTION_DAYS=30
AGENT_RUN_RETENTION_DAYS=90
BACKGROUND_JOB_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=180
ADMIN_ALERT_FAILURE_RATE=0.10
ADMIN_ALERT_CACHE_HIT_RATE=0.20
ADMIN_ALERT_MODEL_P95_MS=10000
ADMIN_ALERT_STUCK_RUN_MINUTES=10
ADMIN_ALERT_MIN_SAMPLE_COUNT=5
ADMIN_ALERT_MIN_CACHE_TOKENS=1000
CHAT_HISTORY_LIMIT=20
HISTORY_COMPRESSION_BATCH_SIZE=10
HISTORY_SUMMARY_MERGE_FACTOR=4
HISTORY_SUMMARY_MAX_CHARS=6000
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_MIN_CONFIDENCE=0.6
MEMORY_EXTRACTION_TIMEOUT_SECONDS=20
MEMORY_RETRIEVAL_MIN_CONFIDENCE=0.6
MEMORY_RETRIEVAL_MAX_ITEMS=20
MEMORY_RETRIEVAL_CANDIDATE_LIMIT=100
MEMORY_RETENTION_NORMAL_DAYS=365
MEMORY_RETENTION_PERSONAL_DAYS=180
MEMORY_RETENTION_SENSITIVE_DAYS=30
AGENT_MAX_STEPS=8
AGENT_MAX_TOTAL_TOKENS=20000
AGENT_MAX_DURATION_SECONDS=120
AGENT_MAX_IDENTICAL_TOOL_CALLS=3
AGENT_MAX_REPEATED_OBSERVATIONS=3
AGENT_REQUESTS_PER_MINUTE=10
AGENT_RUNS_PER_DAY=100
AGENT_TOKENS_PER_DAY=1000000
AGENT_TOOL_CALLS_PER_DAY=500
MCP_DEMO_ENABLED=true
PYTHON_SANDBOX_ENABLED=true
BACKGROUND_QUEUE_NAME=default
BACKGROUND_WORKER_POLL_SECONDS=1
# Optional per-worker heartbeat; Docker config uses /tmp/agent-worker/heartbeat.json.
BACKGROUND_WORKER_HEARTBEAT_PATH=
BACKGROUND_WORKER_HEARTBEAT_MAX_AGE_SECONDS=15
BACKGROUND_JOB_LEASE_SECONDS=30
BACKGROUND_JOB_CONTROL_POLL_SECONDS=1
BACKGROUND_JOB_RETRY_BASE_SECONDS=1
BACKGROUND_JOB_RETRY_MAX_SECONDS=60
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=1
TOOL_RETRY_BACKOFF_SECONDS=0.2
TOOL_ALLOWLIST=demo__get_server_time,demo__calculate,demo__count_text,demo__convert_temperature,demo__simulate_sensitive_action,demo__get_admin_runtime_info,run_python_code
TOOL_APPROVAL_TIMEOUT_SECONDS=300
TOOL_LAZY_LOAD_THRESHOLD=4
TOOL_MAX_LOADED=4
SKILL_SELECTION_MIN_SCORE=20
SKILL_SELECTION_AMBIGUITY_MARGIN=5
CONTEXT_MAX_INPUT_TOKENS=32000
CONTEXT_SYSTEM_TOKEN_BUDGET=2000
CONTEXT_MEMORY_TOKEN_BUDGET=4000
CONTEXT_HISTORY_TOKEN_BUDGET=16000
CONTEXT_TOOL_TOKEN_BUDGET=6000
CONTEXT_RAG_TOKEN_BUDGET=4000
