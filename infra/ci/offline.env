# Synthetic configuration for offline unit tests; never use for deployment.
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=1
DB_NAME=agent_ci_unused
DB_USER=agent_ci
DB_PASSWORD=ci-only-unused-database-password
AUTH_SECRET_KEY=ci-only-auth-secret-with-at-least-32-characters
DEEPSEEK_API_KEY=
LANGSMITH_TRACING_ENABLED=false
MEMORY_EXTRACTION_ENABLED=false
# Unit tests mock sandbox execution and verify its legacy registration/approval gate.
PYTHON_SANDBOX_ENABLED=true
V2_ENABLED=false
PYTHONUTF8=1
