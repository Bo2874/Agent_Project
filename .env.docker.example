# Docker dev configuration only. Copy to .env.docker; pass --env-file .env.docker.
# DEV_ names prevent the host .env / PostgreSQL credentials from being reused implicitly.
DEV_HTTP_PORT=8000
DEV_OPENROUTER_API_KEY=
DEV_WEB_SEARCH_ENABLED=false
DEV_WEB_SEARCH_MODEL=openai/gpt-5.4-mini
DEV_WEB_SEARCH_TIMEOUT_SECONDS=60
DEV_WEB_SEARCH_MAX_OUTPUT_TOKENS=2000
DEV_JEV_BASE_URL=https://openrouter.ai/api
DEV_JEV_MODEL=typesafe/jev-1.14
DEV_JEV_TIMEOUT_SECONDS=15
DEV_JEV_TOTAL_TIMEOUT_SECONDS=20
DEV_ROUTING_MODE=active
DEV_ROUTING_FALLBACK_ENABLED=true
DEV_ROUTING_PRIMARY_TIMEOUT_SECONDS=8
DEV_ROUTING_MAX_PROVIDER_CALLS=12
DEV_ROUTING_MAX_RESERVED_TOKENS=20000
DEV_ROUTING_MIN_PROBABILITY=0.6
DEV_ROUTING_MIN_MARGIN=0.1
DEV_ROUTING_BREAKER_THRESHOLD=3
DEV_ROUTING_BREAKER_COOLDOWN_SECONDS=30
DEV_ROUTING_ALLOW_EXTERNAL=true
DEV_ROUTING_SEND_OBSERVATIONS=true
DEV_ROUTING_REDACT_PII=true
DEV_ROUTING_MAX_STATE_CHARS=32768
DEV_ROUTING_MAX_PAYLOAD_BYTES=131072
DEV_DB_NAME=personal_agent_dev
DEV_DB_USER=agent
DEV_DB_PASSWORD=dev-only-postgres-password
DEV_AUTH_SECRET_KEY=dev-only-auth-secret-change-before-sharing
DEV_DEEPSEEK_API_KEY=
DEV_DEEPSEEK_MODEL=deepseek-flash
DEV_MEMORY_EXTRACTION_ENABLED=false
DEV_MCP_STDIO_CONFIG_PATH=plugins/stdio/servers.json
DEV_MCP_HTTP_CONFIG_PATH=plugins/http/servers.json
DEV_PLUGIN_PACKAGES_CONFIG_PATH=plugins/packages.json
DEV_MCP_CREDENTIAL_ENCRYPTION_KEYS=
# Shared system mailbox; set DEV_EMAIL_ENABLED=true after configuring credentials.
DEV_EMAIL_ENABLED=false
DEV_SMTP_HOST=smtp.gmail.com
DEV_SMTP_PORT=465
DEV_SMTP_SECURITY=ssl
DEV_SMTP_USERNAME=
DEV_SMTP_PASSWORD=
DEV_SMTP_FROM_EMAIL=
DEV_SMTP_TIMEOUT_SECONDS=20
DEV_V2_ENABLED=false
DEV_V2_PLUGINS_ENABLED=false
DEV_V2_ROUTING_ENABLED=false
DEV_AGENT_REACT_ENABLED=false
DEV_AGENT_WEB_SEARCH_ESTIMATED_TOKENS=10000
DEV_AGENT_DOCUMENT_MAX_TOTAL_TOKENS=60000
DEV_V2_RAG_ENABLED=false
DEV_DOCUMENT_MAX_FILE_BYTES=20971520
DEV_DOCUMENT_MAX_USER_BYTES=209715200
DEV_DOCUMENT_MAX_DOCUMENTS=1000
DEV_DOCUMENT_MAX_UNPACKED_BYTES=104857600
DEV_DOCUMENT_MAX_ARCHIVE_ENTRIES=2000
DEV_DOCUMENT_MAX_PAGES=500
DEV_DOCUMENT_MAX_TEXT_CHARS=5000000
DEV_DOCUMENT_MAX_CHUNKS=20000
DEV_DOCUMENT_MAX_ARTIFACT_BYTES=134217728
DEV_DOCUMENT_PROCESS_TIMEOUT_SECONDS=600
DEV_DOCUMENT_PROCESS_MEMORY_MB=4096
DEV_DOCUMENT_EMBEDDING_REVISION=main
DEV_DOCUMENT_EMBEDDING_BATCH_SIZE=4
DEV_DOCUMENT_EMBEDDING_TIMEOUT_SECONDS=600
DEV_DOCUMENT_EMBEDDING_MEMORY_MB=4096
DEV_DOCUMENT_RERANKER_REVISION=main
DEV_DOCUMENT_RERANKER_BATCH_SIZE=1
DEV_DOCUMENT_RERANKER_TIMEOUT_SECONDS=600
DEV_DOCUMENT_RERANKER_MEMORY_MB=4096
DEV_DOCUMENT_REWRITE_TIMEOUT_SECONDS=30
DEV_DOCUMENT_REWRITE_HISTORY_MESSAGES=8
DEV_DOCUMENT_REWRITE_HISTORY_TOKENS=2000
DEV_IMAGE_PREFIX=personal-agent
DEV_IMAGE_TAG=dev
