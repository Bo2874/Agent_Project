# Docker dev configuration only. Copy to .env.docker; pass --env-file .env.docker.
# DEV_ names prevent the host .env / PostgreSQL credentials from being reused implicitly.
DEV_HTTP_PORT=8000
DEV_DB_NAME=personal_agent_dev
DEV_DB_USER=agent
DEV_DB_PASSWORD=dev-only-postgres-password
DEV_AUTH_SECRET_KEY=dev-only-auth-secret-change-before-sharing
DEV_DEEPSEEK_API_KEY=
DEV_DEEPSEEK_MODEL=deepseek-flash
DEV_MEMORY_EXTRACTION_ENABLED=false
DEV_IMAGE_PREFIX=personal-agent
DEV_IMAGE_TAG=dev
