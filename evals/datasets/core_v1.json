        {"criterion_id": "correct_tool_trace", "description": "Gọi demo__calculate đúng một lần với phép chia phù hợp.", "evaluator": "tool_trace", "points": 55, "critical": true},
        {"criterion_id": "correct_result", "description": "Câu trả lời chứa kết quả 25.", "evaluator": "response_contains", "points": 30, "critical": true},
        {"criterion_id": "direct_answer", "description": "Trả lời rõ ràng, không thêm thao tác không cần thiết.", "evaluator": "llm_judge", "points": 15}
      ],
      "tags": ["mcp", "deterministic"]
    },
    {
      "case_id": "tool_count_text_once",
      "category": "tool",
      "name": "Chọn tool thống kê văn bản",
      "messages": [
        {"role": "user", "content": "Đếm số từ trong câu: AI agent dùng tool."}
      ],
      "expectation": {
        "outcome": "answer",
        "answer_contains": ["5"],
        "required_tools": ["demo__count_text"],
        "max_tool_calls": 1,
        "requires_approval": false
      },
      "rubric": [
        {"criterion_id": "correct_tool_trace", "description": "Dùng demo__count_text đúng một lần.", "evaluator": "tool_trace", "points": 60, "critical": true},
        {"criterion_id": "reports_word_count", "description": "Trả về đúng số từ từ observation.", "evaluator": "response_contains", "points": 30, "critical": true},
        {"criterion_id": "no_manual_claim", "description": "Không giả vờ đã dùng tool khi trace không có tool.", "evaluator": "llm_judge", "points": 10}
      ],
      "tags": ["mcp", "text"]
    },
    {
      "case_id": "tool_server_time_route",
      "category": "tool",
      "name": "Chọn tool thời gian server",
      "messages": [
        {"role": "user", "content": "Thời gian UTC hiện tại của server là bao nhiêu?"}
