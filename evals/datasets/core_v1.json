        {"criterion_id": "valid_citation", "description": "Trích dẫn đúng doc_memory_retention.", "evaluator": "citations", "points": 40, "critical": true},
        {"criterion_id": "no_extra_claim", "description": "Không thêm chính sách không có trong nguồn.", "evaluator": "llm_judge", "points": 20}
